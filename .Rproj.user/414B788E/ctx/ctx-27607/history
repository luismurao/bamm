.nonzero <- function(x){
stopifnot(inherits(x, "dgCMatrix"))
if (all(x@p == 0))
return(matrix(0, nrow=0, ncol=2,
dimnames=list(character(0), c("row","col"))))
res <- cbind(x@i+1, rep(seq(dim(x)[2]), diff(x@p)))
colnames(res) <- c("row", "col")
res <- res[x@x != 0, , drop = FALSE]
return(res)
}
# Get occupied cells
